{
    "name": "Ubuntu Rust Development Container",
    "initializeCommand": ".devcontainer/setup-env.sh",
    "dockerFile": "Containerfile",
    "customizations": {
        "vscode": {
            "extensions": [
                "matklad.rust-analyzer"
            ]
        }
    },
    "forwardPorts": [
        8000,
        8080
    ],
    "containerUser": "${localEnv:USER}",
    "runArgs": [
        "--gpus", "all",
        "--security-opt=label=disable"
        "--userns=host"
    ]
}
